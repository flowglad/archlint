{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["files"],
  "properties": {
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceFile" }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleType", "domain", "exemptReason"],
      "properties": {
        "moduleType": {
          "enum": ["", "core", "interface", "value", "shell", "state", "test", "stateTest", "exempt"]
        },
        "domain": { "type": "string" },
        "exemptReason": {
          "enum": [
            "",
            "effect-boundary",
            "effect-facade",
            "entrypoint",
            "pure-glue",
            "static-data",
            "test-support"
          ]
        }
      }
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "propertyCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["references", "generatedInputs", "operationSequences"],
      "properties": {
        "references": { "$ref": "#/$defs/stringList" },
        "generatedInputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/generatedInput" }
        },
        "operationSequences": {
          "type": "array",
          "items": { "$ref": "#/$defs/operationSequence" }
        }
      }
    },
    "generatedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uses"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "uses": { "$ref": "#/$defs/stringList" }
      }
    },
    "operationSequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "operations", "assertions"],
      "properties": {
        "input": { "$ref": "#/$defs/nonEmptyString" },
        "operations": { "$ref": "#/$defs/stringList" },
        "assertions": { "$ref": "#/$defs/stringList" }
      }
    },
    "sharedStateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "references"],
      "properties": {
        "kind": { "$ref": "#/$defs/nonEmptyString" },
        "references": { "$ref": "#/$defs/stringList" }
      }
    },
    "interfaceLogicEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functionBodies",
        "constructorBodies",
        "derivedValueBodies",
        "controlFlow",
        "imperativeDeclarations"
      ],
      "properties": {
        "functionBodies": { "$ref": "#/$defs/stringList" },
        "constructorBodies": { "$ref": "#/$defs/stringList" },
        "derivedValueBodies": { "$ref": "#/$defs/stringList" },
        "controlFlow": { "$ref": "#/$defs/stringList" },
        "imperativeDeclarations": { "$ref": "#/$defs/stringList" }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "testScope",
        "metadata",
        "imports",
        "identifiers",
        "apiReferences",
        "decisionSurface",
        "propertyTestSurface",
        "decisionProducts",
        "decisionReferences",
        "moduleName",
        "qualifiedReferences",
        "effectfulImports",
        "effectfulIdentifiers",
        "sharedState",
        "propertyChecks",
        "interfaceLogicEvidence"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "testScope": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "imports": { "$ref": "#/$defs/stringList" },
        "identifiers": { "$ref": "#/$defs/stringList" },
        "apiReferences": { "$ref": "#/$defs/stringList" },
        "decisionSurface": { "$ref": "#/$defs/stringList" },
        "propertyTestSurface": { "$ref": "#/$defs/stringList" },
        "decisionProducts": { "$ref": "#/$defs/stringList" },
        "decisionReferences": { "$ref": "#/$defs/stringList" },
        "moduleName": { "type": "string" },
        "qualifiedReferences": { "$ref": "#/$defs/stringList" },
        "effectfulImports": { "$ref": "#/$defs/stringList" },
        "effectfulIdentifiers": { "$ref": "#/$defs/stringList" },
        "sharedState": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sharedStateEvidence" }
        },
        "propertyChecks": {
          "type": "array",
          "items": { "$ref": "#/$defs/propertyCheck" }
        },
        "interfaceLogicEvidence": { "$ref": "#/$defs/interfaceLogicEvidence" }
      }
    }
  }
}
